# .env.example

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/quantforge

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=your-openrouter-api-key-here

# --- Research Sources (optional API keys) ---
# arXiv and OpenAlex are free, no key needed
# Crossref is free, email is optional but recommended for polite pool
CROSSREF_MAILTO=your-email@example.com

# --- Environment ---
QUANTFORGE_ENV=development   # development | production
LOG_LEVEL=INFO

# tree -a -I '.git'